# Copy this file to `stocksml.env` and fill secrets for local development.
# Do NOT commit your real secrets to git.

# If you leave DATABASE_URL empty, the app will use a local SQLite database `test.db`.
# Example Postgres (replace with your values if you want to test Postgres locally):
# DATABASE_URL=postgresql://user:password@localhost:5432/stocksml_db?sslmode=require

# For local SQLite leave DATABASE_URL blank or unset
DATABASE_URL=

# JWT secret used by auth
SECRET_KEY=replace-with-a-secure-local-secret

# Optional: when running frontend separately, point it to backend
# Vite envs start with VITE_
VITE_API_URL=http://localhost:8000
